# ── Media paths ──────────────────────────────────────────────────
# Absolute path to the Plex movie library on the Unraid host.
PLEX_MEDIA_PATH=/mnt/user/Media/Movies

# ── Network ──────────────────────────────────────────────────────
# Port this app is reachable on from your browser / Nginx Proxy Manager.
APP_PORT=8085

# Docker network that MariaDB is already on.
# Find it with: docker inspect MariaDB-Official | grep -A5 Networks
DOCKER_NETWORK=hosting_network

# ── App security ─────────────────────────────────────────────────
# Random secret used by Symfony for cookie signing etc.
# Generate one with: openssl rand -hex 32
APP_SECRET=replacethiswiththeoutputofopenssl

# ── Database ─────────────────────────────────────────────────────
# The MariaDB container name (used as hostname inside Docker).
MYSQL_HOST=MariaDB-Official

# MariaDB version — find it with: docker exec MariaDB-Official mariadb --version
MARIADB_VERSION=mariadb-10.11

# Dedicated database + credentials for this app (you create these once — see README).
DB_NAME=media_sync
DB_USER=media_sync
DB_PASSWORD=changeme
